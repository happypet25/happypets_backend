# Backend Environment Variables
PORT=5000

# Nodemailer configuration
# For Gmail, you must use an App Password, not your normal password.
EMAIL_USER=happypettraining25@gmail.com
EMAIL_PASS=your_16_character_app_password_here

# Optional: Add your frontend URLs here separated by commas to restrict CORS
FRONTEND_URLS=https://happypets-frontend.vercel.app,https://happypettraining.com

# ── Google Sheets Integration ────────────────────────────────────────────────
# Step 1: Create a Google Cloud project & enable the Google Sheets API.
# Step 2: Create a Service Account, download the JSON key file.
# Step 3: Create a Google Sheet, rename the first tab to "Leads",
#         and share it with the service-account email (Editor access).
# Step 4: Paste the ENTIRE contents of the JSON key file as a single line below.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}
# Step 5: Copy the Sheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
